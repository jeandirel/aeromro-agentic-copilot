# Copy to .env and adjust. Never commit .env.

# "mock" runs fully offline (default). "bedrock" calls Amazon Bedrock with your AWS credentials.
AEROMRO_LLM_PROVIDER=mock

# Model or inference profile id enabled in your AWS account and region (see the Bedrock console,
# "Model access"). Example of an EU cross-region inference profile: eu.amazon.nova-2-lite-v1:0
AEROMRO_BEDROCK_MODEL_ID=
AEROMRO_AWS_REGION=eu-west-3

AEROMRO_MAX_TOKENS_PER_CALL=1024
AEROMRO_TEMPERATURE=0.0
AEROMRO_TOKEN_BUDGET_PER_SESSION=50000

# Optional: on-demand prices per 1,000 tokens for your model and region, to turn token counts
# into a cost in the telemetry summary. Leave empty to report tokens only.
AEROMRO_PRICE_INPUT_PER_1K_TOKENS=
AEROMRO_PRICE_OUTPUT_PER_1K_TOKENS=

AEROMRO_MIN_RECOMMENDATION_CONFIDENCE=0.7
AEROMRO_RUL_CLIP_CYCLES=125

# API (uvicorn aeromro.api.app:app)
AEROMRO_DATA_DIR=data/raw/CMAPSSData
AEROMRO_MODELS_DIR=models
AEROMRO_INSPECT_NOW_CYCLES=15
AEROMRO_PLAN_INSPECTION_CYCLES=50
# If set, POST /ask requires this value in the X-Access-Code header.
AEROMRO_DEMO_ACCESS_CODE=
AEROMRO_ASK_RATE_LIMIT_PER_MINUTE=10
AEROMRO_ASK_MAX_TOKENS=400
AEROMRO_CORS_ORIGINS=*
