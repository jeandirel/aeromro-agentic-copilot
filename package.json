{
  "name": "aeromro-operations-ui",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "AeroMRO engine-health console: React + TypeScript single-page app served by Vercel, talking to the AWS Lambda API through a same-origin proxy.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "node scripts/serve.mjs",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:proxy": "node --test tests/proxy.test.mjs",
    "test:e2e": "node e2e/run.mjs",
    "test:ui": "npm run lint && npm run typecheck && npm run test && npm run test:proxy && npm run build"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/b612-mono": "5.3.0",
    "@tanstack/react-query": "5.104.5",
    "clsx": "2.1.1",
    "lucide-react": "1.59.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.4",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "playwright-core": "1.64.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
